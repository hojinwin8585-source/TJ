{
  "manifest_version": 3,
  "name": "Naver Web Scraper",
  "version": "4.0.0",
  "description": "네이버/다나와 자동 스크래퍼 - 클릭 한 번으로 상품 데이터 수집",
  "permissions": ["activeTab","scripting","storage","downloads","tabs","sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Naver Web Scraper",
    "default_icon": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "side_panel": {"default_path": "sidepanel.html"},
  "background": {"service_worker": "background.js"},
  "web_accessible_resources": [{"resources":["inject.css","xlsx.min.js"],"matches":["<all_urls>"]}],
  "icons": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}
